{
  "manifest_version": 3,
  "name": "Local Browser Bridge",
  "version": "0.1.0",
  "description": "Connects user-approved browser tabs to a loopback-only control surface for browser agents.",
  "minimum_chrome_version": "116",
  "permissions": [
    "tabs",
    "scripting",
    "storage",
    "alarms",
    "debugger"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Local Browser Bridge"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'"
  }
}
