{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/flrngel/local-browser-bridge/evidence/v0.12.32/browser/scoped-action-approval.schema.json",
  "title": "Local Browser Bridge v0.12.32 stock Chrome scoped action approval",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion", "evidenceType", "releaseCandidateBinding", "candidateBinding",
    "approvalId", "request", "response", "consumption"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "evidenceType": { "const": "stock-user-chrome-scoped-action-approval" },
    "releaseCandidateBinding": { "$ref": "#/$defs/releaseCandidateBinding" },
    "candidateBinding": { "$ref": "#/$defs/candidateBinding" },
    "approvalId": { "$ref": "#/$defs/sha256" },
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "createdAtUtc", "expiresAtUtc", "challengeFrameRef", "scopeSha256", "coveredActions",
        "loopbackOnly", "dedicatedWindowOnly", "restoreCapturedState",
        "noUnrelatedExtensionMutation"
      ],
      "properties": {
        "createdAtUtc": { "$ref": "#/$defs/utcTimestamp" },
        "expiresAtUtc": { "$ref": "#/$defs/utcTimestamp" },
        "challengeFrameRef": { "$ref": "#/$defs/sha256" },
        "scopeSha256": { "$ref": "#/$defs/sha256" },
        "coveredActions": {
          "type": "array",
          "minItems": 8,
          "maxItems": 8,
          "prefixItems": [
            { "const": "conditional-developer-mode-change" },
            { "const": "load-and-run-exact-unpacked-candidate" },
            { "const": "conditional-full-access-change" },
            { "const": "save-ephemeral-loopback-credential" },
            { "const": "clear-ephemeral-loopback-credential" },
            { "const": "remove-exact-test-owned-extension" },
            { "const": "restore-captured-browser-settings" },
            { "const": "failure-rollback" }
          ],
          "items": false
        },
        "loopbackOnly": { "const": true },
        "dedicatedWindowOnly": { "const": true },
        "restoreCapturedState": { "const": true },
        "noUnrelatedExtensionMutation": { "const": true }
      }
    },
    "response": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "approvedBy", "deliveredBy", "orchestratorSessionRef", "confirmationMode",
        "confirmedAtUtc", "requestSha256",
        "singleCandidateRun"
      ],
      "properties": {
        "approvedBy": { "const": "user" },
        "deliveredBy": { "const": "user-via-orchestrator" },
        "orchestratorSessionRef": { "$ref": "#/$defs/sha256" },
        "confirmationMode": { "const": "batched-action-time" },
        "confirmedAtUtc": { "$ref": "#/$defs/utcTimestamp" },
        "requestSha256": { "$ref": "#/$defs/sha256" },
        "singleCandidateRun": { "const": true }
      }
    },
    "consumption": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "consumedBeforeFirstCoveredAction", "consumedBeforeExpiry", "preDispatchFrameRef",
        "preDispatchDecisionRef", "preDispatchVerifiedAtUtc",
        "freshStateRevalidatedAfterApproval", "scopeUnchangedThroughRun",
        "replayed", "cleanupAuthoritySurvivesFailure"
      ],
      "properties": {
        "consumedBeforeFirstCoveredAction": { "const": true },
        "consumedBeforeExpiry": { "const": true },
        "preDispatchFrameRef": { "$ref": "#/$defs/sha256" },
        "preDispatchDecisionRef": { "$ref": "#/$defs/sha256" },
        "preDispatchVerifiedAtUtc": { "$ref": "#/$defs/utcTimestamp" },
        "freshStateRevalidatedAfterApproval": { "const": true },
        "scopeUnchangedThroughRun": { "const": true },
        "replayed": { "const": false },
        "cleanupAuthoritySurvivesFailure": { "const": true }
      }
    }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "sha1": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "utcTimestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{7}Z$"
    },
    "candidateBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "runNonce", "preflightRecordSha256", "finalSha", "checksumManifestSha256",
        "serverSha256", "computerHelperSha256", "extensionZipSha256", "extractedPayloadSha256"
      ],
      "properties": {
        "runNonce": { "$ref": "#/$defs/sha256" },
        "preflightRecordSha256": { "$ref": "#/$defs/sha256" },
        "finalSha": { "$ref": "#/$defs/sha1" },
        "checksumManifestSha256": { "$ref": "#/$defs/sha256" },
        "serverSha256": { "$ref": "#/$defs/sha256" },
        "computerHelperSha256": { "$ref": "#/$defs/sha256" },
        "extensionZipSha256": { "$ref": "#/$defs/sha256" },
        "extractedPayloadSha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "releaseAsset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["file", "bytes", "sha256"],
      "properties": {
        "file": { "type": "string" },
        "bytes": { "type": "integer", "minimum": 1, "maximum": 104857600 },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "releaseCandidateBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion", "version", "releaseTag", "repository", "sourceSha",
        "workflowRunId", "workflowRunAttempt", "workflowEvent", "workflowRef", "workflowPath",
        "artifactId", "artifactName",
        "artifactZipBytes", "artifactZipSha256", "checksumManifestSha256",
        "attestationInvocationUri", "attestedAssetCount", "githubHostedRunner", "assets"
      ],
      "properties": {
        "schemaVersion": { "const": 3 },
        "version": { "const": "0.12.32" },
        "releaseTag": { "const": "v0.12.32" },
        "repository": { "const": "flrngel/local-browser-bridge" },
        "sourceSha": { "$ref": "#/$defs/sha1" },
        "workflowRunId": { "type": "string", "pattern": "^[1-9][0-9]*$" },
        "workflowRunAttempt": { "type": "string", "pattern": "^[1-9][0-9]*$" },
        "workflowEvent": { "const": "workflow_dispatch" },
        "workflowRef": { "const": "refs/heads/main" },
        "workflowPath": { "const": ".github/workflows/deploy.yml" },
        "artifactId": { "type": "string", "pattern": "^[1-9][0-9]*$" },
        "artifactName": { "const": "release-candidate" },
        "artifactZipBytes": { "type": "integer", "minimum": 1 },
        "artifactZipSha256": { "$ref": "#/$defs/sha256" },
        "checksumManifestSha256": { "$ref": "#/$defs/sha256" },
        "attestationInvocationUri": { "type": "string", "pattern": "^https://github\\.com/flrngel/local-browser-bridge/actions/runs/[1-9][0-9]*/attempts/[1-9][0-9]*$" },
        "attestedAssetCount": { "const": 5 },
        "githubHostedRunner": { "const": true },
        "assets": { "type": "array", "minItems": 5, "maxItems": 5, "items": { "$ref": "#/$defs/releaseAsset" } }
      }
    }
  }
}
