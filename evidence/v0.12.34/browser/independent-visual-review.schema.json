{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/flrngel/local-browser-bridge/evidence/v0.12.34/browser/independent-visual-review.schema.json",
  "title": "Local Browser Bridge v0.12.34 independent stock Chrome visual review",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion", "evidenceType", "releaseCandidateBinding", "candidateBinding",
    "executorSessionRef", "reviewerSessionRef", "independentSessionBoundary",
    "requestSha256", "reviewedAtUtc", "entries", "aggregate"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "evidenceType": { "const": "stock-user-chrome-independent-visual-review" },
    "releaseCandidateBinding": { "$ref": "#/$defs/releaseCandidateBinding" },
    "candidateBinding": { "$ref": "#/$defs/candidateBinding" },
    "executorSessionRef": { "$ref": "#/$defs/sha256" },
    "reviewerSessionRef": { "$ref": "#/$defs/sha256" },
    "independentSessionBoundary": { "const": true },
    "requestSha256": { "$ref": "#/$defs/sha256" },
    "reviewedAtUtc": { "$ref": "#/$defs/utcTimestamp" },
    "entries": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "prefixItems": [
        { "$ref": "#/$defs/extensionLoadedReview" },
        { "$ref": "#/$defs/apiResultReview" },
        { "$ref": "#/$defs/computerActionReview" },
        { "$ref": "#/$defs/stopPausedReview" },
        { "$ref": "#/$defs/cancelPausedReview" },
        { "$ref": "#/$defs/postHandbackResumeReview" }
      ],
      "items": false
    },
    "aggregate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reviewedCropCount", "everySanitizedCropOpenedByReviewer", "allImageDigestsMatched",
        "requiredVisibleStateConfirmedByReviewer", "noSensitivePixelsObservedByReviewer",
        "noUncertaintyReported", "visualJudgmentNotPixelSafetyProof"
      ],
      "properties": {
        "reviewedCropCount": { "const": 6 },
        "everySanitizedCropOpenedByReviewer": { "const": true },
        "allImageDigestsMatched": { "const": true },
        "requiredVisibleStateConfirmedByReviewer": { "const": true },
        "noSensitivePixelsObservedByReviewer": { "const": true },
        "noUncertaintyReported": { "const": true },
        "visualJudgmentNotPixelSafetyProof": { "const": true }
      }
    }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "sha1": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "utcTimestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{7}Z$"
    },
    "candidateBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "runNonce", "preflightRecordSha256", "finalSha", "checksumManifestSha256",
        "serverSha256", "computerHelperSha256", "extensionZipSha256", "extractedPayloadSha256"
      ],
      "properties": {
        "runNonce": { "$ref": "#/$defs/sha256" },
        "preflightRecordSha256": { "$ref": "#/$defs/sha256" },
        "finalSha": { "$ref": "#/$defs/sha1" },
        "checksumManifestSha256": { "$ref": "#/$defs/sha256" },
        "serverSha256": { "$ref": "#/$defs/sha256" },
        "computerHelperSha256": { "$ref": "#/$defs/sha256" },
        "extensionZipSha256": { "$ref": "#/$defs/sha256" },
        "extractedPayloadSha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "releaseAsset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["file", "bytes", "sha256"],
      "properties": {
        "file": { "type": "string" },
        "bytes": { "type": "integer", "minimum": 1, "maximum": 104857600 },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "releaseCandidateBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion", "version", "releaseTag", "repository", "sourceSha",
        "workflowRunId", "workflowRunAttempt", "workflowEvent", "workflowRef", "workflowPath",
        "artifactId", "artifactName",
        "artifactZipBytes", "artifactZipSha256", "checksumManifestSha256",
        "attestationInvocationUri", "attestedAssetCount", "githubHostedRunner", "assets"
      ],
      "properties": {
        "schemaVersion": { "const": 3 },
        "version": { "const": "0.12.34" },
        "releaseTag": { "const": "v0.12.34" },
        "repository": { "const": "flrngel/local-browser-bridge" },
        "sourceSha": { "$ref": "#/$defs/sha1" },
        "workflowRunId": { "type": "string", "pattern": "^[1-9][0-9]*$" },
        "workflowRunAttempt": { "type": "string", "pattern": "^[1-9][0-9]*$" },
        "workflowEvent": { "const": "workflow_dispatch" },
        "workflowRef": { "const": "refs/heads/main" },
        "workflowPath": { "const": ".github/workflows/deploy.yml" },
        "artifactId": { "type": "string", "pattern": "^[1-9][0-9]*$" },
        "artifactName": { "const": "release-candidate" },
        "artifactZipBytes": { "type": "integer", "minimum": 1 },
        "artifactZipSha256": { "$ref": "#/$defs/sha256" },
        "checksumManifestSha256": { "$ref": "#/$defs/sha256" },
        "attestationInvocationUri": { "type": "string", "pattern": "^https://github\\.com/flrngel/local-browser-bridge/actions/runs/[1-9][0-9]*/attempts/[1-9][0-9]*$" },
        "attestedAssetCount": { "const": 5 },
        "githubHostedRunner": { "const": true },
        "assets": { "type": "array", "minItems": 5, "maxItems": 5, "items": { "$ref": "#/$defs/releaseAsset" } }
      }
    },
    "reviewEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sequence", "purpose", "image", "sha256", "width", "height",
        "requiredVisibleStateSha256", "digestMatched", "requiredStateVerdict",
        "sensitivePixelsObserved", "uncertain"
      ],
      "properties": {
        "sequence": { "type": "integer", "minimum": 1, "maximum": 6 },
        "purpose": { "type": "string" },
        "image": { "type": "string" },
        "sha256": { "$ref": "#/$defs/sha256" },
        "width": { "type": "integer", "minimum": 120, "maximum": 8192 },
        "height": { "type": "integer", "minimum": 32, "maximum": 8192 },
        "requiredVisibleStateSha256": { "$ref": "#/$defs/sha256" },
        "digestMatched": { "const": true },
        "requiredStateVerdict": { "const": "pass" },
        "sensitivePixelsObserved": { "const": false },
        "uncertain": { "const": false }
      }
    },
    "extensionLoadedReview": {
      "$ref": "#/$defs/reviewEntry",
      "properties": {
        "sequence": { "const": 1 },
        "purpose": { "const": "extension-loaded" },
        "image": { "const": "browser-01-extension-loaded.png" },
        "requiredVisibleStateSha256": { "const": "5764248024bb50b8ad86542edb67cbdd6722860300a79b4f09cb20df53de699c" }
      }
    },
    "apiResultReview": {
      "$ref": "#/$defs/reviewEntry",
      "properties": {
        "sequence": { "const": 2 },
        "purpose": { "const": "api-action-result" },
        "image": { "const": "browser-02-api-action-result.png" },
        "requiredVisibleStateSha256": { "const": "9b4760f10e59348d1dc62d1675dd8e4e37e9d7f43319dd008550a82ee2d7713a" }
      }
    },
    "computerActionReview": {
      "$ref": "#/$defs/reviewEntry",
      "properties": {
        "sequence": { "const": 3 },
        "purpose": { "const": "computer-share-action" },
        "image": { "const": "browser-03-computer-share-action.png" },
        "requiredVisibleStateSha256": { "const": "ddfaa39fd27aa63976ff33c51eb0a039678315ad94675ffea5ddc49b58307fb5" }
      }
    },
    "stopPausedReview": {
      "$ref": "#/$defs/reviewEntry",
      "properties": {
        "sequence": { "const": 4 },
        "purpose": { "const": "stop-paused" },
        "image": { "const": "browser-04-stop-paused.png" },
        "requiredVisibleStateSha256": { "const": "8d5edbd5ba3bb68ad5c29d435443d40a99c031588e1c8848fc4e000fe5264db5" }
      }
    },
    "cancelPausedReview": {
      "$ref": "#/$defs/reviewEntry",
      "properties": {
        "sequence": { "const": 5 },
        "purpose": { "const": "cancel-paused" },
        "image": { "const": "browser-05-cancel-paused.png" },
        "requiredVisibleStateSha256": { "const": "c7b811bff71f513e5dd978147b9b3a24a901d68f0fdfc0e25d78cfeee6807fcb" }
      }
    },
    "postHandbackResumeReview": {
      "$ref": "#/$defs/reviewEntry",
      "properties": {
        "sequence": { "const": 6 },
        "purpose": { "const": "post-handback-resume" },
        "image": { "const": "browser-06-post-handback-resume.png" },
        "requiredVisibleStateSha256": { "const": "168b59500e1e99c51db2b33cb370277857e8c5285308bc1e962c00f7c0ad01a6" }
      }
    }
  }
}
