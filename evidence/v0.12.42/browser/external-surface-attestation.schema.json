{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/flrngel/local-browser-bridge/evidence/v0.12.42/browser/external-surface-attestation.schema.json",
  "title": "Local Browser Bridge v0.12.42 stock Chrome external-surface attestation",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion", "evidenceType", "phase", "releaseCandidateBinding",
    "releaseCandidateBindingSha256", "orchestrationSurface", "chromeMcpState",
    "computerUseState", "reviewerInputState", "attestorKind",
    "attestorSessionRef", "attestedAtUtc"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "evidenceType": { "const": "stock-user-chrome-external-surface-attestation" },
    "phase": { "enum": ["preflight", "postflight"] },
    "releaseCandidateBinding": { "$ref": "operator-results.schema.json#/$defs/releaseCandidateBinding" },
    "releaseCandidateBindingSha256": { "$ref": "#/$defs/sha256" },
    "orchestrationSurface": { "const": "user-orchestrator-secured-ssh-exported-file-review" },
    "chromeMcpState": {
      "enum": [
        "not-used-before-candidate-execution",
        "never-used-through-independent-review"
      ]
    },
    "computerUseState": {
      "enum": [
        "released-before-candidate-execution",
        "not-resumed-through-independent-review"
      ]
    },
    "reviewerInputState": {
      "enum": ["review-not-started", "exported-digest-bound-files-only"]
    },
    "attestorKind": { "const": "orchestrator-agent" },
    "attestorSessionRef": { "$ref": "#/$defs/sha256" },
    "attestedAtUtc": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{7}Z$"
    }
  },
  "allOf": [
    {
      "if": { "properties": { "phase": { "const": "preflight" } } },
      "then": {
        "properties": {
          "chromeMcpState": { "const": "not-used-before-candidate-execution" },
          "computerUseState": { "const": "released-before-candidate-execution" },
          "reviewerInputState": { "const": "review-not-started" }
        }
      }
    },
    {
      "if": { "properties": { "phase": { "const": "postflight" } } },
      "then": {
        "properties": {
          "chromeMcpState": { "const": "never-used-through-independent-review" },
          "computerUseState": { "const": "not-resumed-through-independent-review" },
          "reviewerInputState": { "const": "exported-digest-bound-files-only" }
        }
      }
    }
  ],
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
  }
}
